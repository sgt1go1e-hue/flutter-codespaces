{
  "name": "piping-isometric-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "配管アイソメ図作成アプリ (PWA)",
  "scripts": {
    "predev": "node scripts/free-vite.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:beta": "tsc --noEmit && vite build --mode beta --outDir dist-beta",
    "preview": "vite preview",
    "test:units": "node scripts/test-units.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
